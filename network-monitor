#!/usr/bin/env bash
set -e
DIR="$(cd "$(dirname "$0")" && pwd)"
PY="$DIR/python3/bin/python3.14"
if [ ! -x "$PY" ]; then
  PY="$(command -v python3 || true)"
fi
if [ -z "$PY" ]; then
  echo "لم يتم العثور على مفسّر Python 3." >&2
  exit 1
fi
export PYTHONPATH="$DIR/src:${PYTHONPATH:-}"
exec "$PY" -m netmon "$@"
