#!/bin/sh
HERE="$(dirname "$(readlink -f "$0")")"
export PYTHONHOME="$HERE/usr"
export PYTHONPATH="$HERE/usr/share/network-monitor/src:$HERE/usr/lib/python3.12/site-packages"
export NETWORK_MONITOR_HELPER="$HERE/usr/libexec/network-monitor/network-monitor-helper"
export QT_PLUGIN_PATH="$HERE/usr/lib/python3.12/site-packages/PySide6/Qt/plugins"
export LD_LIBRARY_PATH="$HERE/usr/lib/python3.12/site-packages/PySide6/Qt/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$HERE/usr/bin/python3" -m netmon "$@"
