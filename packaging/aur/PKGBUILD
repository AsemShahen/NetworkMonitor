# Binary package built from the official .deb release asset.
# Update pkgver and sha256sums together for every release.
pkgname=network-monitor-qt-bin
_pkgname=network-monitor
pkgver=1.1.0
pkgrel=1
pkgdesc="Netlink-based per-application network monitor with usage and blocking (Qt/PySide6 binary release)"
arch=('x86_64')
url="https://github.com/AsemShahen/NetworkMonitor"
license=('GPL-3.0-or-later')
depends=(
    'glibc'
    'gcc-libs'
    'python3'
    'polkit'
    'nftables'
    'iproute2'
    'dbus'
    'glib2'
    'fontconfig'
    'freetype2'
    'libglvnd'
    'libx11'
    'libxext'
    'libxrender'
    'libxi'
    'libsm'
    'libice'
    'libxcb'
    'libxkbcommon'
    'libxkbcommon-x11'
    'xcb-util'
    'xcb-util-cursor'
    'xcb-util-wm'
    'xcb-util-image'
    'xcb-util-keysyms'
    'xcb-util-renderutil'
)
optdepends=('noto-fonts: improved Arabic font rendering')
provides=('network-monitor')
conflicts=('network-monitor' 'network-monitor-bin')
options=('!strip' '!debug')
install="${pkgname}.install"
source=("${url}/releases/download/v${pkgver}/${_pkgname}_${pkgver}_amd64.deb")
sha256sums=('02749e5dbe4e026ff45776deb771410c0255a7d98cb94efcc2e3dab1303f6a4a')
makedepends=('binutils' 'zstd')

package() {
    cd "$srcdir"
    ar x "${_pkgname}_${pkgver}_amd64.deb"
    tar -xf data.tar.*
    install -d "$pkgdir"
    cp -a opt usr "$pkgdir/"
}
